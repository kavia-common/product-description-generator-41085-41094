# Public env variables consumed on the client (do not include secrets)
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED=true
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
NEXT_PUBLIC_PORT=3000
NEXT_PUBLIC_TRUST_PROXY=false
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_HEALTHCHECK_PATH=/healthz
# Feature flags as JSON object
NEXT_PUBLIC_FEATURE_FLAGS={"fancyOutput":true,"copyEnabled":true,"shareEnabled":true,"persistenceEnabled":true}
NEXT_PUBLIC_EXPERIMENTS_ENABLED=false
